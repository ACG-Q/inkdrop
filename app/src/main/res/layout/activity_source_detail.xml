<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="源详情"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/btn_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 源名称 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="源名称"
                android:textSize="12sp"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/et_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:inputType="text"
                android:background="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black" />

            <!-- 源ID（新建时可编辑，编辑时只读） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="源ID"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:paddingTop="12dp" />

            <EditText
                android:id="@+id/et_detail_source_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:inputType="text"
                android:background="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black" />

            <!-- 类型选择器（新建时显示） -->
            <LinearLayout
                android:id="@+id/layout_type_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="类型"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <TextView
                        android:id="@+id/btn_type_json"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="JSON"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:background="@color/black"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_type_js"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="JS"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:background="@drawable/border_black_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/btn_type_302"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="302"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:background="@drawable/border_black_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- 类型展示（编辑时显示） -->
            <LinearLayout
                android:id="@+id/layout_type_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="类型"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_detail_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black" />

            </LinearLayout>

            <!-- === JSON 专用字段 === -->
            <LinearLayout
                android:id="@+id/layout_json_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 请求URL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请求URL"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="支持 {page} {pageSize} 占位符"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_url_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:inputType="textUri"
                    android:background="@android:color/transparent"
                    android:hint="https://api.example.com/wallpapers?page={page}&amp;pageSize={pageSize}" />

                <TextView
                    android:id="@+id/btn_smart_parse"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="智能解析"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:background="@drawable/border_black_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black" />

                <!-- 响应解析 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="响应解析"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="数据列表字段名"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_data_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:text="data" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="项目字段"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ID字段"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_id_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:text="id" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="URL字段"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_url_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:text="url" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="宽度字段"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_width_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:text="width" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="高度字段"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_height_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:text="height" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black" />

                <!-- 图片配置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="图片配置"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="图片基础地址（相对路径时拼接用）"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_image_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:inputType="textUri"
                    android:background="@android:color/transparent"
                    android:hint="可选" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="预览图后缀"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_detail_preview_suffix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:hint="format=webp&amp;w=600&amp;q=85" />

            </LinearLayout>

            <!-- === 302 专用字段 === -->
            <LinearLayout
                android:id="@+id/layout_302_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请求URL"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="302源：返回图片直链或302跳转"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <EditText
                    android:id="@+id/et_302_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:inputType="textUri"
                    android:background="@android:color/transparent"
                    android:hint="https://api.example.com/images" />

            </LinearLayout>

            <!-- === JS 编辑按钮 === -->
            <TextView
                android:id="@+id/btn_edit_js"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="编辑 JS 代码"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:background="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- 底部按钮 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="保存"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:background="@color/black"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="删除"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:background="@drawable/border_black_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</LinearLayout>
